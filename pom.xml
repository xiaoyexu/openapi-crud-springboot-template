    </dependencies>
    <build>
        <finalName>openapi-service</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.1.0</version>
                <configuration>
                    <dependenciesToScan>
                        <dependency>com.xuxiaoye</dependency>
                    </dependenciesToScan>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.openapitools</groupId>
                <artifactId>openapi-generator-maven-plugin</artifactId>
                <version>7.12.0</version>
                <executions>
                    <execution>
                        <id>generate-api-server</id>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                        <configuration>
                            <inputSpec>${project.basedir}/src/main/resources/swagger/server/sample.yaml</inputSpec>
                            <generatorName>spring</generatorName>
                            <apiPackage>com.xuxiaoye.api.adapter.api.server</apiPackage>
                            <modelPackage>com.xuxiaoye.api.adapter.api.server.dto</modelPackage>
                            <supportingFilesToGenerate>ApiUtil.java</supportingFilesToGenerate>
                            <importMappings>Problem=org.zalando.problem.Problem</importMappings>
                            <skipValidateSpec>false</skipValidateSpec>
                            <generateModelTests>false</generateModelTests>
                            <generateApiTests>false</generateApiTests>
                            <configOptions>
                                <delegatePattern>true</delegatePattern>
                                <title>ArchitectureDojo</title>
                                <useJakartaEe>true</useJakartaEe>
                                <useSpringBoot3>true</useSpringBoot3>
                                <additionalModelTypeAnnotations>
                                    @lombok.Data @lombok.NoArgsConstructor @lombok.AllArgsConstructor @lombok.Builder
                                </additionalModelTypeAnnotations>
                            </configOptions>
                        </configuration>
                    </execution>
                    <!--                    <execution>-->
                    <!--                        <id>generate-api-client</id>-->
                    <!--                        <goals>-->
                    <!--                            <goal>generate</goal>-->
                    <!--                        </goals>-->
                    <!--                        <configuration>-->
                    <!--                            <inputSpec>${project.basedir}/src/main/resources/swagger/client/sample.yaml</inputSpec>-->
                    <!--                            <generatorName>spring</generatorName>-->
                    <!--                            <apiPackage>com.xuxiaoye.openapi.api.client</apiPackage>-->
                    <!--                            <modelPackage>com.xuxiaoye.openapi.api.client.dto</modelPackage>-->
                    <!--                            <supportingFilesToGenerate>ApiUtil.java</supportingFilesToGenerate>-->
                    <!--                            <configOptions>-->
                    <!--                                <delegatePattern>true</delegatePattern>-->
                    <!--                                <title>ArchitectureDojo</title>-->
                    <!--                            </configOptions>-->
                    <!--                        </configuration>-->
                    <!--                    </execution>-->
                </executions>
            </plugin>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.7</version>
                <configuration>
                    <excludes>
                        <exclude>com/xuxiaoye/api/adapter/api/server/**/*.class</exclude>
                        <exclude>com/xuxiaoye/api/adapter/api/server_ng/**/*.class</exclude>
                        <exclude>com/xuxiaoye/api/adapter/api/client/**/*.class</exclude>
                        <exclude>com/xuxiaoye/api/Application.class</exclude>
                        <exclude>com/xuxiaoye/api/adapter/client/mapper/**</exclude>
                        <exclude>com/xuxiaoye/api/adapter/server/mapper/**</exclude>
                        <exclude>com/xuxiaoye/api/aspects/ClientAPICallAspect.class</exclude>
                    </excludes>
                </configuration>
                <executions>
                    <!-- Generate .exec file -->
                    <execution>
                        <id>pre-unit-test</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>check</id>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>CLASS</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.80</minimum>
                                        </limit>
                                        <limit>
                                            <counter>BRANCH</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.80</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                    <execution>
                        <id>post-unit-test</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>target/site/jacoco</outputDirectory>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
